# Spotify OAuth Configuration
VITE_CLIENT_ID=your_spotify_app_client_id_here
VITE_REDIRECT_URI=http://localhost:5173/callback
VITE_BACKEND_URL=http://localhost:5000

# Spotify Client Secret (KEEP SECRET - BACKEND ONLY!)
# This is used for token refresh on the backend
SPOTIFY_CLIENT_SECRET=your_spotify_app_client_secret_here

# MongoDB Configuration
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/chromophobia?retryWrites=true&w=majority

# Optional: Server Port
PORT=5000
